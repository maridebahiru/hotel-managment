{
  "name": "hotel-digital-menu-root",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "client:dev": "npm run dev --workspace=client",
    "server:dev": "npm run dev --workspace=server",
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspace=client",
    "prebuild": "npx prisma generate --schema=server/prisma/schema.prisma"
  },
  "devDependencies": {
    "prisma": "^7.8.0"
  }
}
